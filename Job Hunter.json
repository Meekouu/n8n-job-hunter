        "jsCode": "const clip = (s, n) => {\n  s = s || '';\n  return s.length > n ? s.slice(0, n - 1) + '…' : s;\n};\n\nconst divider = '━'.repeat(100);\nconst out = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n\n  // Message 1: the verdict and the summary\n  const first =\n    `${divider}\\n🎯 **${j.score}/100**: ${clip(j.title, 150)}\\n` +\n    `${j.url}\\n\\n` +\n    `**Why:** ${j.reason}\\n` +\n    `**Gaps:** ${j.gaps || 'none noted'}\\n` +\n    `⚠️ **Verify before sending:** ${j.claims_to_verify || 'nothing flagged'}\\n\\n` +\n    `**Summary**\\n${j.tailored_summary}`;\n\n  // Message 2: the material you will copy\n  const second =\n    `**Bullets**\\n${j.tailored_bullets}\\n\\n` +\n    `**Cover letter**\\n${j.cover_letter}`;\n\n  out.push({ json: { content: clip(first, 1900) } });\n  out.push({ json: { content: clip(second, 1900) } });\n}\n\nreturn out;"
      },
