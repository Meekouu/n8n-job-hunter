    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const title = $json.title.toLowerCase();\nconst text = `${$json.title} ${$json.description}`.toLowerCase();\n\n// Word-boundary match, so \"ai\" doesn't hit \"email\" or \"maintain\"\nconst has = (word) =>\n  new RegExp('\\\\b' + word.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + '\\\\b', 'i').test(text);\n\n// EDIT THESE LISTS to taste\nconst mustHave = [\n  'automation', 'n8n', 'zapier', 'make.com', 'workflow', 'api', 'integration',\n  'no-code', 'low-code', 'ai', 'data analyst', 'business analyst', 'analytics',\n  'sql', 'python', 'javascript', 'react', 'firebase', 'next.js', 'flutter',\n  'full-stack', 'full stack', 'web developer', 'junior developer'\n];\n\nconst blockTitle = [\n  'senior', 'sr.', 'director', 'head of', 'principal', 'manager',\n  'sales', 'closer', 'setter', 'caller', 'telemarketer', 'accountant',\n  'bookkeeper', 'amazon'\n];\n\nconst blockText = [\n  'cold call', 'cold calling', 'commission only', 'commission-only',\n  '100% commission', 'dialer'\n];\n\n// Catches \"5+ years\", \"7 years of experience\", etc. (5 or more)\nconst seniorYears = /\\b([5-9]|1\\d)\\+?\\s*(years|yrs)\\b/i.test(text);\n\nconst matched = mustHave.filter(has);\nconst blockedBy = [\n  ...blockTitle.filter(w => title.includes(w)).map(w => 'title: ' + w),\n  ...blockText.filter(w => text.includes(w)).map(w => 'text: ' + w),\n  ...(seniorYears ? ['5+ years required'] : []),\n];\n\nreturn {\n  json: {\n    ...$json,\n    matched,\n    blockedBy,\n    passes: matched.length >= 2 && blockedBy.length === 0,\n  },\n};"
      },
